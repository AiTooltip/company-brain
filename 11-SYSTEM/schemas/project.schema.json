{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aitooltip/company-brain/schemas/project.schema.json",
  "title": "Company Brain Project Metadata",
  "type": "object",
  "required": ["id", "name", "status", "owner", "sponsor", "approved_by", "approval_date", "departments", "products", "created", "target_date", "last_updated"],
  "properties": {
    "id": { "type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "approved", "active", "blocked", "paused", "completed", "cancelled"] },
    "owner": { "type": "string", "minLength": 1 },
    "sponsor": { "type": "string", "minLength": 1 },
    "approved_by": { "type": "string", "minLength": 1 },
    "approval_date": { "anyOf": [{ "$ref": "#/$defs/date" }, { "const": "unknown" }] },
    "departments": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "products": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "created": { "$ref": "#/$defs/date" },
    "target_date": { "anyOf": [{ "$ref": "#/$defs/date" }, { "const": "unknown" }] },
    "last_updated": { "$ref": "#/$defs/date" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["approved", "active", "blocked", "paused", "completed"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "approved_by": { "not": { "const": "unknown" } },
          "approval_date": { "not": { "const": "unknown" } }
        }
      }
    }
  ],
  "$defs": { "date": { "type": "string", "format": "date" } },
  "additionalProperties": true
}

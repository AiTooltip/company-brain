{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AI-Tooltip/company-brain/schemas/goal.schema.json",
  "title": "Company Brain Goal Metadata",
  "type": "object",
  "required": ["id", "title", "status", "owner", "department", "horizon", "created", "updated", "success_measure", "approved_by", "related_projects", "related_decisions", "dependencies"],
  "properties": {
    "id": { "type": "string", "pattern": "^goal-[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "approved", "active", "achieved", "paused", "cancelled", "superseded"] },
    "owner": { "type": "string", "minLength": 1 },
    "department": { "type": "string", "minLength": 1 },
    "horizon": { "type": "string", "minLength": 1 },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "success_measure": { "type": "string", "minLength": 1 },
    "approved_by": { "type": "string", "minLength": 1 },
    "related_projects": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "related_decisions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["approved", "active", "achieved", "paused"] } }, "required": ["status"] },
      "then": { "properties": { "approved_by": { "not": { "const": "unknown" } } } }
    }
  ],
  "additionalProperties": true
}
